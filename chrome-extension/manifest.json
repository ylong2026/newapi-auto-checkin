{
  "manifest_version": 3,
  "name": "NewAPI 多站自动签到",
  "version": "2.2.0",
  "description": "多站点 NewAPI 中转站自动签到，支持 Turnstile/WAF 站点，随机时间，Telegram 通知",
  "permissions": ["storage", "alarms", "tabs", "scripting", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NewAPI 自动签到"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
